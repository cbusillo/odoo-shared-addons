{
  "defaultBranch": "main",
  "projectType": "odoo-shared-addon-collection",
  "docs": {
    "index": "README.md",
    "repoGuide": "AGENTS.md",
    "codeqlWorkflow": ".github/workflows/codeql.yml",
    "addonGuides": [
      "authentik_sso/AGENTS.md",
      "discuss_record_links/AGENTS.md",
      "environment_banner/AGENTS.md",
      "environment_banner/README.md",
      "external_ids/AGENTS.md",
      "hr_employee_name_extended/AGENTS.md",
      "hr_employee_name_extended/README.md",
      "launchplane_settings/AGENTS.md",
      "notification_permission_patch/AGENTS.md",
      "test_support/AGENTS.md",
      "transaction_utilities/AGENTS.md"
    ]
  },
  "qualityGate": {
    "json": {
      "metadata": "jq empty .github/github.json"
    },
    "test": {
      "addonOdoo": "odoo-bin --test-enable --stop-after-init -i <addon>"
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": [
        "changed_files",
        "directory",
        "whole_project"
      ]
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "operations changes",
      "ownership boundaries change",
      "addon behavior changes",
      "addon dependency changes",
      "security/access-rule changes",
      "tenant validation routing changes"
    ]
  },
  "importantWorkflows": ["CodeQL"],
  "prWorkflow": {
    "mergeHandoff": "After CI passes and review findings are accounted for, comment Ready for the merge train. The direction session owns train entry and driving; executing agents do not label for entry, drive the train or merge by hand. See AGENTS.md.",
    "requiredStatusChecks": ["Analyze (python)"],
    "branchProtectionNotes": [
      "Re-read live branch protection and rulesets before landing; this metadata describes routing, not authority to change those settings.",
      "Branch protection requires Analyze (python) with an up-to-date branch. CodeQL also analyzes JavaScript/TypeScript; the Require code scanning results ruleset blocks analysis errors and high-or-higher security alerts."
    ],
    "validationNotes": "CI here runs CodeQL. Addon behavior tests require an assembled odoo-devkit workspace or the relevant tenant environment; addonOdoo is an Odoo invocation template, not a standalone checkout gate. See AGENTS.md."
  },
  "launchplane": {
    "enabled": true,
    "mergeTrain": {
      "enabled": true,
      "controller": true,
      "readyLabel": "ready-to-merge",
      "baseBranch": "main"
    }
  },
  "relatedRepos": [
    "odoo-devkit",
    "odoo-tenant-cm",
    "odoo-tenant-opw",
    "launchplane"
  ],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "merge path changes",
      "branch protection or rulesets change",
      "repo relationship changes",
      "cleanup policy changes",
      "ownership boundaries change",
      "addon list changes",
      "addon dependency changes",
      "tenant validation routing changes"
    ]
  }
}
