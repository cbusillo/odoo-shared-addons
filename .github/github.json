{
  "defaultBranch": "main",
  "projectType": "odoo-shared-addon-collection",
  "docs": {
    "index": "README.md",
    "repoGuide": "AGENTS.md",
    "codeqlWorkflow": ".github/workflows/codeql.yml",
    "addonGuides": [
      "authentik_sso/AGENTS.md",
      "discuss_record_links/AGENTS.md",
      "environment_banner/AGENTS.md",
      "environment_banner/README.md",
      "external_ids/AGENTS.md",
      "hr_employee_name_extended/AGENTS.md",
      "hr_employee_name_extended/README.md",
      "launchplane_settings/AGENTS.md",
      "notification_permission_patch/AGENTS.md",
      "test_support/AGENTS.md",
      "transaction_utilities/AGENTS.md"
    ],
    "launchplaneMergeTrain": "https://github.com/cbusillo/codex-skills/blob/main/skills/launchplane/references/merge-train.md"
  },
  "qualityGate": {
    "json": {
      "metadata": "jq empty .github/github.json"
    },
    "test": {
      "local": "ADDON_TEST_ROOT=\"${ADDON_TEST_ROOT:?Set ADDON_TEST_ROOT to a prepared directory containing selected owned addon directories}\" bash -euo pipefail -c \"$(jq -er '.qualityGate.test.addonOdoo' .github/github.json)\"",
      "ci": "ADDON_TEST_ROOT=\"$PWD\" bash -euo pipefail -c \"$(jq -er '.qualityGate.test.addonOdoo' .github/github.json)\"",
      "addonOdoo": "uv --directory \"${ODOO_DEVKIT_REPO:-../odoo-devkit}\" run --locked python -m odoo_devkit.addon_ci --image \"${ADDON_TEST_IMAGE:?Set ADDON_TEST_IMAGE to the community devtools image used by CI}\" --addons-root \"${ADDON_TEST_ROOT:-$PWD}\" --support-root \"${ODOO_SHARED_ADDONS_REPO:-$PWD}\" --output \"${ADDON_TEST_OUTPUT:?Set ADDON_TEST_OUTPUT to a task-evidence directory}\""
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": [
        "changed_files",
        "directory",
        "whole_project"
      ]
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "operations changes",
      "ownership boundaries change",
      "addon behavior changes",
      "addon dependency changes",
      "security/access-rule changes",
      "tenant validation routing changes"
    ],
    "lint": {
      "tls": "uv tool run --from ruff==0.17.1 ruff check --select S501,S502,S503,S504,S323 . && uv run https://raw.githubusercontent.com/cbusillo/codex-skills/9755c971d886ce9a6eb6ee52e169e5afe869a439/scripts/check_insecure_tls.py"
    }
  },
  "importantWorkflows": [
    "CodeQL",
    "Addon tests",
    "TLS lint"
  ],
  "prWorkflow": {
    "requiredStatusChecks": [
      "Analyze (python)"
    ],
    "branchProtectionNotes": [
      "Re-read live branch protection and rulesets before landing; this metadata describes routing, not authority to change those settings.",
      "Branch protection requires Analyze (python) with an up-to-date branch. CodeQL also analyzes JavaScript/TypeScript; the Require code scanning results ruleset blocks error-severity alerts and high-or-higher security alerts."
    ]
  },
  "launchplane": {
    "enabled": true,
    "service": {
      "contextUrlEnv": "LAUNCHPLANE_CONTEXT_URL",
      "operatorUrlEnv": "LAUNCHPLANE_OPERATOR_URL"
    }
  },
  "relatedRepos": [
    "odoo-devkit",
    "odoo-tenant-cm",
    "odoo-tenant-opw",
    "launchplane"
  ],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "merge path changes",
      "branch protection or rulesets change",
      "repo relationship changes",
      "cleanup policy changes",
      "ownership boundaries change",
      "addon list changes",
      "addon dependency changes",
      "tenant validation routing changes"
    ]
  }
}
