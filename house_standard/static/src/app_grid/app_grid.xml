<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="house_standard.AppGrid">
        <div class="o_house_app_grid h-100 overflow-auto">
            <nav class="o_house_app_grid_apps" aria-label="Apps">
                <a
                    t-foreach="this.apps"
                    t-as="app"
                    t-key="app.id"
                    class="o_house_app"
                    t-att-href="app.href"
                    t-att-data-menu-xmlid="app.xmlid"
                    t-on-click.prevent="() => this.openApp(app)"
                >
                    <img class="o_house_app_icon" t-att-src="app.webIconData or '/base/static/description/icon.png'" alt=""/>
                    <span class="o_house_app_name" t-out="app.label"/>
                </a>
            </nav>
        </div>
    </t>

    <t t-name="house_standard.NavBar.AppsMenu" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//AppsMenu" position="replace">
            <a href="/odoo/house-home" class="dropdown-toggle" data-hotkey="h" title="Home Menu">
                <i class="oi" data-icon="apps" aria-hidden="true"/>
            </a>
        </xpath>
    </t>

    <t t-name="house_standard.NavBar.AppsMenu.Sidebar" t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension">
        <xpath expr="//a[@t-on-click.prevent='this.onAllAppsBtnClick']" position="attributes">
            <attribute name="href">/odoo/house-home</attribute>
            <attribute name="t-on-click.prevent"/>
            <attribute name="t-on-click">this._closeAppMenuSidebar</attribute>
        </xpath>
    </t>
</templates>
